# deploy/vps/api-gateway.service — systemd unit for the API gateway.
#
# OPTIONAL self-host path. setup_gateway.sh renders the @PLACEHOLDERS@ and
# installs this to /etc/systemd/system/api-gateway.service, then:
#   sudo systemctl enable --now api-gateway
#
# Runs uvicorn bound to LOOPBACK ONLY (127.0.0.1). Public traffic reaches it
# exclusively through Caddy (TLS termination + reverse proxy). The gateway is
# never directly exposed. Secrets are injected from .env via EnvironmentFile —
# never hardcode keys here.

[Unit]
Description=API Gateway (FastAPI/uvicorn) — routing layer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Reuse the existing AOA service account, which owns the CLI logins.
User=@SERVICE_USER@
Group=@SERVICE_USER@

WorkingDirectory=@GATEWAY_DIR@

# Secrets + tunables. GATEWAY_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY,
# GOOGLE_AI_API_KEY, PORT, etc. live ONLY in this file (mode 600, gitignored).
EnvironmentFile=-@GATEWAY_DIR@/.env

# Bind loopback only — Caddy is the sole public entrypoint.
ExecStart=@GATEWAY_DIR@/.venv/bin/uvicorn main:app --host 127.0.0.1 --port @GATEWAY_PORT@

Restart=always
RestartSec=5

# --- Hardening (defence in depth) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# The CLI-default path (future cli_providers module) shells out to claude/codex/
# agy, which read credentials from the service account home; relax ProtectHome
# to read-only so those credential files remain readable. If the gateway needs
# to write a CLI cache, add a ReadWritePaths= line for that specific directory.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=api-gateway

[Install]
WantedBy=multi-user.target
